{
  "buildCommand": "npm run build",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- src/ public/ package.json api/",
  "crons": [
    {
      "path": "/api/cron/lifecycle-emails",
      "schedule": "0 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://auth-app-feed3.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://auth-app-feed3.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/api/cron/:path*",
      "destination": "/api/cron/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api.newcollab.co/:path*"
    }
  ]
}
